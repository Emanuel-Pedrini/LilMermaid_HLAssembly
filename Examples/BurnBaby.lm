def size 64
def dummy_memory 0x4C00
go 0x7C00

@funny_func()
    << .reg(1)
    .reg(1)! 
    .reg(1) = (.reg(2) + .reg(3)) + (.reg(4) as $size) $size

@save_char()
    & (dummy_memory + .reg(2)), .reg(1)
    .reg(2) += 1 $64

@for()
    .reg(3) = *.reg(4) $8 ## * means the value in position, when used alone, like C
    .reg(3) != '\0'
    ## imaginary print func
    if (.reg(4) ++)
    if (go for)


@main()
    .reg(1) = 43 $64
    .reg(2) = 958 $64
    .reg(3) = 4590 $size
    .reg(4) = 'c' $(size / 8)
    
    funny_func()
    
    .reg(1) << 17 $size
    .reg(1) >> 29 $size
    .reg(1) ^^ (179875 as $size) $size

    & 0x4000, .reg(1) ## & now is the operand

    .reg(2)!
    .reg(1)!
    .reg(3)!
    .reg(4)!

    .reg(2) = 1 $64

    .reg(1) = 'H' $8
    save_char()

    .reg(1) = 'e' $8
    save_char()

    .reg(1) = 'l' $8
    save_char()

    .reg(1) = 'l' $8
    save_char()

    .reg(1) = 'o' $8
    save_char()

    .reg(1) = '\0' $8
    save_char()

    .reg(4) = dummy_memory + 1
    for()

